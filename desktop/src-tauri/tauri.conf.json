{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legado Desktop",
  "version": "0.1.2",
  "identifier": "io.xiatou.legado.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Legado desktop reader",
    "longDescription": "Legado Desktop - a Windows reader for Legado book sources.",
    "resources": ["runtime", "server", "frontend"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
